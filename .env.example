# Application
APP_ENV=development                    # development | production
SECRET_KEY=change-me-in-production     # used for signing JWTs

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=recipe_manager
POSTGRES_USER=recipe_manager
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Qdrant
QDRANT_URL=http://qdrant:6333

# Ollama (local embedding model)
OLLAMA_URL=http://host.docker.internal:11434   # Ollama runs on host, not in Docker
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ingredient cost API (optional)
COST_API_KEY=

# Scraping
MAX_SCRAPE_RETRIES=3
SCRAPE_TIMEOUT_SECONDS=30
