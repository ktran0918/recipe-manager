<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- No tab characters anywhere in source files -->
    <module name="FileTabCharacter"/>

    <!-- LineLength must live at the Checker level, not inside TreeWalker -->
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">

        <!-- ── Imports ──────────────────────────────────────────────────── -->
        <!--
            Google Java Style Guide: no wildcard imports — with one exception.
            allowStaticMemberImports permits static wildcards for fluent test
            DSLs (MockMvcRequestBuilders.*, MockMvcResultMatchers.*, Mockito.*),
            which Spring's own docs use and which are designed to be imported
            wholesale. Regular type wildcards (jakarta.persistence.*, etc.)
            remain banned.
        -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <!-- Remove imports that aren't used -->
        <module name="UnusedImports"/>
        <!-- Block sun.* and com.sun.* internal APIs -->
        <module name="IllegalImport"/>

        <!-- ── Naming ────────────────────────────────────────────────────── -->
        <module name="TypeName"/>            <!-- Classes/interfaces: UpperCamelCase -->
        <!--
            Methods: lowerCamelCase, with optional underscore-separated segments.
            Allows the JUnit methodName_condition_expectedResult convention and
            Spring Data JPA derived query names like findByHousehold_Id.
        -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
        </module>
        <module name="LocalVariableName"/>   <!-- Variables: lowerCamelCase -->
        <module name="ConstantName"/>        <!-- Static finals: UPPER_SNAKE_CASE -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- ── Correctness ───────────────────────────────────────────────── -->
        <!-- If you override equals(), you must override hashCode() too -->
        <module name="EqualsHashCode"/>
        <!-- Never compare Strings with == (use .equals()) -->
        <module name="StringLiteralEquality"/>
        <!-- Simplify: !(a == b) → a != b -->
        <module name="SimplifyBooleanExpression"/>
        <!-- Empty catch/finally blocks must have a comment explaining why -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

    </module>
</module>
